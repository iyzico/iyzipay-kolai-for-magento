<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- API: endpoints are proxied so each request builds only the stack it uses. -->
    <type name="Iyzico\Kolai\Model\Api\Dispatcher">
        <arguments>
            <argument name="products" xsi:type="object">Iyzico\Kolai\Model\Endpoint\Products\Proxy</argument>
            <argument name="reviews" xsi:type="object">Iyzico\Kolai\Model\Endpoint\Reviews\Proxy</argument>
            <argument name="shipping" xsi:type="object">Iyzico\Kolai\Model\Endpoint\Shipping\Proxy</argument>
            <argument name="orders" xsi:type="object">Iyzico\Kolai\Model\Endpoint\Orders\Proxy</argument>
            <argument name="contracts" xsi:type="object">Iyzico\Kolai\Model\Endpoint\Contracts\Proxy</argument>
        </arguments>
    </type>

    <!-- One logger and one isolated connection per process. -->
    <type name="Iyzico\Kolai\Model\Log\Logger" shared="true"/>
    <type name="Iyzico\Kolai\Model\Db\IsolatedConnection" shared="true"/>

    <!-- Payment method "kolai": a gateway facade whose only command is refund. -->
    <virtualType name="KolaiPaymentFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Iyzico\Kolai\Model\Payment\PaymentMethod::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">KolaiPaymentValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">KolaiPaymentCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="KolaiPaymentConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Iyzico\Kolai\Model\Payment\PaymentMethod::CODE</argument>
        </arguments>
    </virtualType>
    <virtualType name="KolaiPaymentConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">KolaiPaymentConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="KolaiPaymentValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">KolaiPaymentConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="KolaiPaymentCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="refund" xsi:type="string">Iyzico\Kolai\Gateway\Command\RefundCommand</item>
            </argument>
        </arguments>
    </virtualType>
</config>
